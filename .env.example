# Copiez ce fichier en .env et adaptez. AUCUNE cle n'est requise pour le MVP.
# Le mode par defaut est deterministe (reponse officielle FAQ, sans LLM).

# --- Retrieval ---
USE_EMBEDDINGS=false

# --- LLM optionnel (jamais requis) ---
# Si LLM_ENABLED=false, l'assistant fonctionne en mode deterministe.
LLM_ENABLED=false
LLM_PROVIDER=none            # none | openai | anthropic

# Renseignez la cle UNIQUEMENT si LLM_ENABLED=true. Ne committez jamais .env.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- API ---
API_HOST=127.0.0.1
API_PORT=8000

# URL de l'API utilisee par Streamlit et la recette (sinon moteur local direct).
ASSISTANT_API_URL=http://127.0.0.1:8000
